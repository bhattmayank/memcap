<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.memcap.watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__INSTALL_DIR__/watchdog.sh</string>
    </array>
    <key>StartInterval</key><integer>10</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__INSTALL_DIR__/logs/monitor.out</string>
    <key>StandardErrorPath</key><string>__INSTALL_DIR__/logs/monitor.err</string>
    <key>WorkingDirectory</key><string>__INSTALL_DIR__</string>
</dict>
</plist>
